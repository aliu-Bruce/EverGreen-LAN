<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="EverGreen LAN"
           Language="1033"
           Version="0.1.0"
           Manufacturer="EverGreen LAN"
           UpgradeCode="8F3C2E1A-6B4D-4F8A-9C12-7E5D3A1B0C44">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of EverGreen LAN is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="EverGreen LAN" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="EverGreen LAN">
          <Component Id="ApplicationShortcut" Guid="A1B2C3D4-1111-2222-3333-444455556666">
            <Shortcut Id="DesktopShortcut" Directory="DesktopFolder"
                      Name="EverGreen LAN" Target="[INSTALLFOLDER]eglan_ui.exe"
                      WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
            <RegistryValue Root="HKCU" Key="Software\EverGreenLAN" Name="installed"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <Icon Id="AppIcon" SourceFile="$(var.SourceDir)\eglan_ui.exe" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
  </Product>
</Wix>
